// Cloudflare Workers settings for technyah.com.
// "name" must match the Worker's name in the Cloudflare dashboard (Workers & Pages list).
{
  "name": "technyah",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  // Runs on every deploy, so the dashboard needs no build command.
  "build": { "command": "node build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Keep variables typed into the dashboard when a new version deploys.
  "keep_vars": true,
  "observability": { "enabled": true },

  // Message storage and file storage. No IDs needed: Cloudflare creates both on the first deploy
  // and keeps using them after that.
  "d1_databases": [{ "binding": "DB", "database_name": "technyah-forms" }],
  "kv_namespaces": [{ "binding": "FILES" }]
}
